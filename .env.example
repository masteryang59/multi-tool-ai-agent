# --- LLM ---------------------------------------------------------------------------------------
# Leave both empty to use the scripted demo model in mock_services (no key needed, not a real LLM).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible server with tool calling, e.g. Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b
OPENAI_BASE_URL=

# --- Tools -------------------------------------------------------------------------------------
# auto = tavily if TAVILY_API_KEY is set, else brave if BRAVE_API_KEY is set, else wikipedia (keyless)
# mock = the fake Tavily in mock_services (offline)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=

# open-meteo = the real, keyless Open-Meteo API; mock = the fake one in mock_services (offline)
WEATHER_PROVIDER=open-meteo

DB_PATH=data/shop.db

# --- Agent loop limits -------------------------------------------------------------------------
MAX_STEPS=6
MAX_TOOL_CALLS=12
TOOL_TIMEOUT_SECONDS=20
MAX_TOOL_RESULT_CHARS=6000
MAX_HISTORY_CHARS=40000
ENCODE_TOKEN=enabled
LOAD_CONFIG=enabled